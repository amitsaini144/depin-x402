# Solana RPC for frontend (devnet). Use Helius or another provider.
# Note: NEXT_PUBLIC_ vars ship in the public JS bundle — only put devnet/public keys here.
NEXT_PUBLIC_HELIUS_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY

# Public URL of the deployed facilitator (Railway). In local dev, use http://localhost:4000.
NEXT_PUBLIC_FACILITATOR_URL=https://your-facilitator.up.railway.app
